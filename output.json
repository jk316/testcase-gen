{
  "description": "save testcase template",
  "path": "//v1/cl/testcase/save",
  "input": [
    {
      "name": "timestamp",
      "type": "string",
      "required": false,
      "description": "unix timestamp, expired in 10 minutes, type is int"
    },
    {
      "name": "session_id",
      "type": "string",
      "required": false,
      "description": "allocated session id"
    },
    {
      "name": "body",
      "type": "object",
      "required": true,
      "description": ""
    },
    {
      "name": "dynamic_apply",
      "type": "boolean",
      "required": false,
      "description": "dynamic apply Maximum Flows Per Second and Maximum Simultaneous Flows"
    },
    {
      "name": "testcase_id",
      "type": "integer",
      "required": false,
      "description": "testcase id"
    },
    {
      "name": "app_replay_list",
      "type": "array",
      "required": false,
      "description": "application replay list"
    },
    {
      "name": "app_simulator_list",
      "type": "array",
      "required": false,
      "description": "application simulator list"
    },
    {
      "name": "criteria_list",
      "type": "array",
      "required": false,
      "description": "criteria list"
    },
    {
      "name": "ddos_attack_list",
      "type": "array",
      "required": false,
      "description": "ddos attack list"
    },
    {
      "name": "ipsec_simulator_list",
      "type": "array",
      "required": false,
      "description": "ipsec simulator list"
    },
    {
      "name": "layer2_replay_list",
      "type": "array",
      "required": false,
      "description": "layer2 replay list"
    },
    {
      "name": "malware_list",
      "type": "array",
      "required": false,
      "description": "malware list"
    },
    {
      "name": "ping_setting",
      "type": "array",
      "required": false,
      "description": "ping info"
    },
    {
      "name": "security_list",
      "type": "array",
      "required": false,
      "description": "security list"
    },
    {
      "name": "session_sender_list",
      "type": "array",
      "required": false,
      "description": "session sender list"
    },
    {
      "name": "custom_stats",
      "type": "array",
      "required": false,
      "description": "custom stats info; default: []"
    },
    {
      "name": "enable_cpu_usage",
      "type": "boolean",
      "required": false,
      "description": "enable cpu usgae; default: false"
    },
    {
      "name": "enable_custom_stats",
      "type": "boolean",
      "required": false,
      "description": "enable custom stats; default: false"
    },
    {
      "name": "enable_port_packet_capture",
      "type": "boolean",
      "required": false,
      "description": "enable port packet capture ; default: false"
    },
    {
      "name": "enable_testcase_sharing",
      "type": "boolean",
      "required": false,
      "description": "enable testcase sharing; default: false"
    },
    {
      "name": "network_id",
      "type": "integer",
      "required": false,
      "description": "network id"
    },
    {
      "name": "network_name",
      "type": "string",
      "required": false,
      "description": "network name"
    },
    {
      "name": "port_reset",
      "type": "boolean",
      "required": false,
      "description": "reset port data; default: false"
    },
    {
      "name": "sample_interval",
      "type": "integer",
      "required": false,
      "description": "the period between data samples; default: 1; range: 1-3600"
    },
    {
      "name": "testcase_desc",
      "type": "string",
      "required": false,
      "description": "testcase description; length: 0-65535"
    },
    {
      "name": "testcase_name",
      "type": "string",
      "required": false,
      "description": "testcase name; length: 1-128"
    },
    {
      "name": "xapp_simulator_list",
      "type": "array",
      "required": false,
      "description": "extend application simulator list"
    }
  ],
  "output": [
    {
      "name": "code",
      "type": "integer",
      "required": false,
      "description": "response code, zero for success, non-zero for errors"
    },
    {
      "name": "message",
      "type": "string",
      "required": false,
      "description": "response message, description for the response code"
    }
  ]
}