{
    "workflow_id": "alps_test_execution_v1",
    "description": "Canonical workflow for executing test cases via ALPS RESTful APIs",
    "version": "1.0",
  
    "stages": [
      {
        "stage_id": "authentication",
        "type": "mandatory",
        "description": "Authenticate user into the ALPS client",
        "allowed_apis": [
          "/v1/cl/user/login"
        ]
      },
  
      {
        "stage_id": "port_prepare",
        "type": "mandatory",
        "description": "Retrieve available ports before reservation",
        "allowed_apis": [
          "/v1/cl/port/list"
        ]
      },
  
      {
        "stage_id": "port_reserve",
        "type": "mandatory",
        "description": "Reserve one or more ports for test execution",
        "allowed_apis": [
          "/v1/cl/port/reserve",
          "/v1/cl/port/batch/reserve"
        ]
      },
  
      {
        "stage_id": "testcase_prepare",
        "type": "mandatory",
        "description": "Create or locate an existing test case",
        "allowed_apis": [
          "/v1/cl/testcase/create",
          "/v1/cl/testcase/list",
          "/v1/cl/testcase/search"
        ]
      },
  
      {
        "stage_id": "network_config",
        "type": "mandatory",
        "description": "Configure network neighbor parameters for the test case",
        "allowed_apis": [
          "/v1/cl/network/create",
          "/v1/cl/network/list",
          "/v1/cl/network/search",
          "/v1/cl/network/param/fetch",
          "/v1/cl/network/param/update",
          "/v1/cl/network/save",
          "/v1/cl/network/saveas"
        ]
      },
  
      {
        "stage_id": "load_profile_config",
        "type": "mandatory",
        "description": "Configure traffic load profile",
        "allowed_apis": [
          "/v1/cl/load/profile/create",
          "/v1/cl/load/profile/list",
          "/v1/cl/load/profile/fetch",
          "/v1/cl/load/profile/param/update",
          "/v1/cl/load/profile/save",
          "/v1/cl/load/profile/saveas"
        ]
      },
      {
        "stage_id": "component_config",
        "type": "optional",
        "description": "Configure optional test components",
        "allowed_apis": [
          "/v1/cl/testcase/component/create",
          "/v1/cl/testcase/component/list",
          "/v1/cl/testcase/component/search",
          "/v1/cl/testcase/component/fetch"
        ]
      },
  
      {
        "stage_id": "testcase_finalize",
        "type": "mandatory",
        "description": "Bind resources and save final test case configuration",
        "allowed_apis": [
          "/v1/cl/testcase/param/fetch",
          "/v1/cl/testcase/save",
          "/v1/cl/testcase/saveas"
        ]
      },
  
      {
        "stage_id": "testcase_execute",
        "type": "mandatory",
        "description": "Run or stop the test case",
        "allowed_apis": [
          "/v1/cl/testcase/run",
          "/v1/cl/testcase/stop"
        ]
      },
  
      {
        "stage_id": "stats_collect",
        "type": "mandatory",
        "description": "Collect real-time or historical test statistics",
        "allowed_apis": [
          "/v1/cl/testcase/instance/search",
          "/v1/cl/stats/model",
          "/v1/cl/stats/category/search",
          "/v1/cl/stats/history/model",
          "/v1/cl/stats/history/category/search"
        ]
      },
  
      {
        "stage_id": "resource_cleanup",
        "type": "mandatory",
        "description": "Release reserved ports and clean up resources",
        "allowed_apis": [
          "/v1/cl/port/release",
          "/v1/cl/port/batch/release"
        ]
      },
  
      {
        "stage_id": "logout",
        "type": "mandatory",
        "description": "Logout from ALPS client",
        "allowed_apis": [
          "/v1/cl/user/logout"
        ]
      }
    ],
  
    "ordering_rules": {
      "authentication": ["port_prepare"],
      "port_prepare": ["port_reserve"],
      "port_reserve": ["testcase_prepare"],
      "testcase_prepare": ["network_config", "load_profile_config"],
      "network_config": ["testcase_finalize"],
      "load_profile_config": ["testcase_finalize"],
      "testcase_finalize": ["testcase_execute"],
      "testcase_execute": ["stats_collect"],
      "stats_collect": ["resource_cleanup"],
      "resource_cleanup": ["logout"]
    },
  
    "global_constraints": {
      "single_session": true,
      "cleanup_required": true
    }
  }
  