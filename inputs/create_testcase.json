{
    "name": "Simple testcase",
    "demand": "testcase v0.0.0",
    "tester": "XRT Darpeng",
    "steps": [
      {
        "step": 0,
        "description": "Set some parameters.",
        "guidance": "Set some basic parameters, such as Base_url, username and password",
        "input": [
          {
            "name": "BASE_URL",
            "type": "str",
            "description": "The BASE_URL is https://10.99.80.111:7070"
          },
          {
            "name": "USERNAME",
            "type": "str",
            "description": "The USERNAME is admin"
          },
          { 
            "name": "PASSWORD",
            "type": "str",
            "description": "The PASSWORD is admin"
          },
          {
            "name": "attack_name",
            "type": "str",
            "description": "The attack profile name keyword to search for,'e.g., 'UDP Flood Attack'"
          },
          {
            "name": "testcase_name",
            "type": "str",
            "description": "The testcase name to create, e.g.'TestCase_by_agent_{datetime.now().strftime('%Y%m%d_%H%M%S')}' "
          }
          
        ]
      },
      {
        "step": 1,
        "description": "Login WITH signature",
        "guidance": "Call /v1/cl/user/login with signature, which should be calculated with password and something else",
        "input": [
          {
            "name": "BASE_URL",
            "type": "str",
            "description": "API base without trailing slash"
          },
          {
            "name": "USERNAME",
            "type": "str",
            "description": "username for login"
          },
          {
            "name": "PASSWORD",
            "type": "str",
            "description": "password for login"
          }
        ],
        "output": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          }
        ]
      },
      {
        "step": 2,
        "description": "List all network neighbors",
        "guidance": "Call /v1/cl/network/list to search for all network neighbors, then extract the network where the network_name is 'ZGC Scene Two Network' and output its network_id and network_name.",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          }
        ],
        "output": [
          {
            "name": "network_id",
            "type": "int",
            "description": "Default network neighbor ID extracted from response"
          },
          {
            "name": "network_name",
            "type": "str",
            "description": "network name extracted from response"
          }
        ]
      },
      {
        "step": 3,
        "description": "Fetch network details",
        "guidance": "Call /v1/cl/network/fetch with network_id to retrieve full configuration, including ipv4_static_host_list.",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          },
          {
            "name": "network_id",
            "type": "int",
            "description": "ID of the network to fetch"
          }
        ],
        "output": [
          {
            "name": "ipv4_static_host_list",
            "type": "list[dict]",
            "description": "Static IPv4 hosts returned by the API"
          }
        ]
      },
      {
        "step": 4,
        "description": "Fetch network component tags",
        "guidance": "Call /v1/cl/network/tags/fetch with network_id to retrieve component tags.",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          },
          {
            "name": "network_id",
            "type": "int",
            "description": "Network ID whose component tags will be fetched"
          }
        ],
        "output": [
          {
            "name": "component_tags",
            "type": "list[str]",
            "description": "List of component tags associated with the given network"
          }
        ]
      },
      {
        "step": 5,
        "description": "List all DDoS attack profiles",
        "guidance": "Call /v1/cl/ddos/attack/profile/list to retrieve all attack profiles, then Select an attack profile from the returned results that matches or contains the attack_name (which is the output from step 0). Output profile_id and profile_name.",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          },
          {
            "name": "attack_name",
            "type": "str",
            "description": "keyword to identify the required attack profile"
          }
        ],
        "output": [
          {
            "name": "profile_id",
            "type": "int",
            "description": "ID of the attack profile matching the test requirement"
          },
          {
            "name": "profile_name",
            "type": "str",
            "description": "Name of the matched attack profile"
          }
        ]
      },
      {
        "step": 6,
        "description": "Create Testcase",
        "guidance": "Call /v1/cl/testcase/create with testcase_name",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          },
          {
            "name": "testcase_name",
            "type": "str",
            "description": "Name of the testcase to create"
          },
          {
            "name": "overwrite",
            "type": "bool",
            "description": "Whether to overwrite an existing testcase with the same name,default is True"
          }
        ],
        "output": [
          {
            "name": "testcase_id",
            "type": "int",
            "description": "ID of the created testcase"
          },
          {
            "name": "shared_settings",
            "$ref": "#/definitions/testcase.TestcaseSettings",
            "description": "Shared settings of the created testcase"
          }
        ]
      },
      {
        "step": 7,
        "description": "Find the required parameters and define the 'testcase.DdosAttack' parameter.",
        "guidance": "Recursively search for the parameters required by 'testcase.DdosAttack': If a parameter has appeared in previous outputs, reuse it;If not, generate new parameter values based on the parameter ranges defined in the reference documentation.",
        "$ref": "#/definitions/testcase.DdosAttack",
        "input": [
          {
            "name": "profile_id",
            "type": "int",
            "description": "DDoS attack profile ID used to update the testcase"
          },
          {
            "name": "profile_name",
            "type": "str",
            "description": "Name of the attack profile"
          },
          {
            "name": "testcase_name",
            "type": "str",
            "description": "Name of the testcase"
          },
          {
            "name": "testcase_id",
            "type": "int",
            "description": "ID of the testcase to fetch"
          }
        ],
        "output": [
          {
            "name": "ddos_attack_list",
            "type": "list",
            "description": "ddos attack list",
            "items": {
              "$ref": "#/definitions/testcase.DdosAttack"
            }
          }
        ]
      },
      {
        "step": 8,
        "description": "Find the required parameters and define the 'shared_settings' parameter.",
        "guidance": "Recursively search for the parameters required by 'shared_settings': If a parameter has appeared in previous outputs, reuse it;If not, generate new parameter values based on the parameter ranges defined in the reference documentation.",
        "$ref": "#/definitions/testcase.TestcaseSettings",
        "input": [
          {
            "name": "network_id",
            "type": "int",
            "description": "Network ID used to update the testcase"
          },
          {
            "name": "network_name",
            "type": "str",
            "description": "Name of the network"
          },
          {
            "name": "testcase_name",
            "type": "str",
            "description": "Name of the testcase"
          }
        ],
        "output": [
          {
            "name": "shared_settings",
            "description": "shared component settings",
            "items": {
              "$ref": "#/definitions/testcase.TestcaseSettings"
            }
          }
        ]
      },
      {
        "step": 9,
        "description": "Find the required parameters and define the 'testcase_info' parameter.",
        "guidance": "Recursively search for the parameters required by 'testcase_info': If a parameter has appeared in previous outputs, reuse it;If not, generate new parameter values based on the parameter ranges defined in the reference documentation.",
        "$ref": "#/definitions/testapi.TestcaseInfo",
        "input": [
          {
            "name": "shared_settings",
            "$ref": "#/definitions/testcase.TestcaseSettings",
            "description": "shared component settings"
          },
          {
            "name": "ddos_attack_list",
            "type": "list",
            "description": "ddos attack list",
            "items": {
              "$ref": "#/definitions/testcase.DdosAttack"
            }
          }
        ],
        "output": [
          {
            "name": "testcase_info",
            "description": "testcase information",
            "$ref": "#/definitions/testapi.TestcaseInfo"
          }
        ]
      },
      {
        "step": 10,
        "description": "Save testcase",
        "guidance": "Call /v1/cl/testcase/save with testcase_info to save or update the testcase.",
        "input": [
          {
            "name": "testcase_id",
            "type": "int",
            "description": "testcase_id from output"
          },
          {
            "name": "testcase_info",
            "description": "testcase information",
            "$ref": "#/definitions/testapi.TestcaseInfo"
          }
        ],
        "output": [
          {
            "name": "testcase_id",
            "type": "int",
            "description": "ID of the saved or updated testcase"
          }
        ]
      },
      {
        "step": 11,
        "description": "Run the testcase",
        "guidance": "Call /v1/cl/testcase/run with testcase_id and testcase_name to start executing the testcase.",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          },
          {
            "name": "testcase_id",
            "type": "int",
            "description": "ID of the testcase to run"
          },
          {
            "name": "testcase_name",
            "type": "str",
            "description": "name of the testcase"
          }
        ],
        "output": [
          {
            "name": "instance_id",
            "type": "int",
            "description": "testcase instance id"
          }
        ]
      },
      {
        "step": 12,
        "description": "Logout current user",
        "guidance": "Call /v1/cl/user/logout with the current username (e.g., admin) to terminate the session.",
        "input": [
          {
            "name": "session_id",
            "type": "str",
            "description": "session_id from response"
          },
          {
            "name": "timestamp",
            "type": "str",
            "description": "unix timestamp, expired in 10 minutes"
          },
          {
            "name": "name",
            "type": "str",
            "description": "Username to logout, such as admin"
          }
        ],
        "output": [
          {
            "name": "code",
            "type": "int",
            "description": "Returned logout result status, response code, zero for success, non-zero for errors"
          }
        ]
      }
    ]
  }